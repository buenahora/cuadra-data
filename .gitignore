# Entorno Python (uv)
.venv/
__pycache__/
*.pyc

# Warehouse local y datos generados -- reproducibles corriendo
# pipelines/run_local_real.py (real) o pipelines/run_local.py (sintético,
# en su propia ruta -- ver docstring de ese script), no se versionan.
data/raw/*.csv
data/raw_synthetic/*.csv
data/processed/*
!data/processed/.gitkeep
data/*.duckdb
data/*.duckdb.wal

