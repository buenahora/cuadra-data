dbt/target/
dbt/dbt_packages/
dbt/logs/
config/.user.yml

# Secretos locales (ver config/.env.example)
.env

# pytest / cobertura
.pytest_cache/
.coverage
htmlcov/

# Airflow (cuando se active -- ver pipelines/dags/)
airflow.db
airflow.cfg
airflow-webserver.pid
logs/

.DS_Store

# Artefactos del CI (deploy.yml)
build/
