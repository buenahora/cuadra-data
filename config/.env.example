# Copiar a data_layer/.env (gitignored) y ajustar si hace falta.
# Sin este archivo, los defaults de config/connections.yml alcanzan para dev local.

# Entorno activo: dev | prod (prod no está definido todavía, ver docs/business.md §8)
CUADRA_ENV=dev

# Ruta absoluta o relativa (a data_layer/) al archivo DuckDB del warehouse.
# Si no se define, se usa el default de config/connections.yml para CUADRA_ENV.
# CUADRA_DUCKDB_PATH=./data/warehouse.duckdb

# Placeholders para cuando existan (ver config/connections.yml):
# GEOCODING_API_KEY=
# FUENTE_EXTERNA_LISTADOS_API_KEY=
